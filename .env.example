# Existing LLM configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Persistent semantic knowledge base
VECTORSTORE_PATH=data/chroma

# Local SQLite client-deliverables database (created by scripts/init_sqlite.py or on first use)
SQLITE_DB_PATH=data/client_deliverables.sqlite

# Notion local integration: index the pages you intentionally want in the semantic knowledge base.
# Current workspace pages: Agentic RAG notes, Himachal itinerary, grocery list,
# Indian history timeline, and weekday routine.
NOTION_TOKEN=
NOTION_VERSION=2026-03-11
NOTION_PAGE_IDS=40913ff4-8027-813f-8a87-e67b0c490e7d,8da527f7-c735-4fbe-a3bd-28cb4196582c,b4b1b58c-7b40-4e63-9ff4-435991fb86b0,9fe63913-a4fa-48e2-a38a-516116e36050,40913ff4-8027-80a0-9443-fd4251898b92

# Hybrid retrieval tuning
RAG_TOP_K=5
RAG_HYBRID_CANDIDATES=20
RAG_HYBRID_VECTOR_WEIGHT=0.65
RAG_HYBRID_LEXICAL_WEIGHT=0.35
RAG_HYBRID_BM25_K1=1.2
RAG_HYBRID_BM25_B=0.75

# DeepEval evaluation model (defaults to OPENAI_MODEL in the eval scripts)
DEEPEVAL_MODEL=gpt-4o-mini
