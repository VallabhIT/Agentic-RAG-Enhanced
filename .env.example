# Existing LLM configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Existing Chroma location (same persistent knowledge_base collection)
VECTORSTORE_PATH=data/chroma

# Notion local integration (share the intended pages with the integration)
NOTION_TOKEN=
NOTION_VERSION=2026-03-11
NOTION_PAGE_IDS=

# Optional PostgreSQL relational store; set this only after starting Compose
DATABASE_URL=
POSTGRES_DB=agentic_rag
POSTGRES_USER=agentic_rag
POSTGRES_PASSWORD=local_dev_change_me
POSTGRES_PORT=5432
